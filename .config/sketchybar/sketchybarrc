source ~/.cache/wal/colors.sh
primary_color="0xFF$(echo ${color13} | tail -c 7)"
background_color="0xde$(echo ${background} | tail -c 7)"
PLUGINDIR="~/.config/sketchybar/plugins"

sketchybar --bar position=top height=24 color=${background_color} blur_radius=15 \
                 border_color=${primary_color} border_width=1 \
                 margin=10 y_offset=11 corner_radius=9
sketchybar --default icon.font="Hack Nerd Font:Bold:14.0" \
    background.height=21 \
    background.padding_left=4 \
    background.padding_right=4 \
    label.color=${primary_color} \
    icon.color=${primary_color} \
    popup.height=22 \
    popup.blur_radius=15 \
    popup.background.border_color=${primary_color} \
    popup.background.color=${background_color} \
    popup.background.border_width=1 \
    popup.background.corner_radius=9 \
    slider.knob.color=${primary_color} \
    slider.highlight_color=${primary_color}

sketchybar --add item clock right \
    --set clock script="$PLUGINDIR/clock.sh" \
                update_freq=10 \
                label.padding_right=1

sketchybar --add item battery right \
    --set battery script="$PLUGINDIR/battery.sh" \
                  update_freq=60 \
                  icon.padding_right=5

source ~/.config/sketchybar/weatherConfig.sh

source ~/.config/sketchybar/spotifyConfig.sh

source ~/.config/sketchybar/calendarConfig.sh

sketchybar --add item clipboardReset left \
    --set clipboardReset label="" \
                         click_script="pbpaste | pbcopy"

sketchybar --add item screenShot left \
    --set screenShot label="screenshot" \
    --set screenShot script="$PLUGINDIR/screenshotTarget.sh" \
                     click_script="$PLUGINDIR/screenshotSwitcher.sh; $PLUGINDIR/screenshotTarget.sh"

sketchybar --update

